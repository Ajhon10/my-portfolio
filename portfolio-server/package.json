{
	"name": "portfolio-server",
	"version": "0.0.1",
	"description": "MY PORTFOLIO backend (NestJS)",
	"author": "Jhon Lisley Jeresano",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "node dist/main",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "npm run build && node dist/main",
		"migrate:generate": "npx prisma generate dev --create-only",
		"migrate:up": "npx prisma generate dev",
		"migrate:seed": "npx prisma db seed",
		"migrate:reset": "npx prisma migrate reset",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage"
	},
	"prisma": {
		"schema": "./src/database/schema",
		"seed": "ts-node src/database/seed.ts"
	},
	"dependencies": {
		"@nestjs/cache-manager": "^2.2.2",
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^3.2.1",
		"@nestjs/core": "^10.0.0",
		"@nestjs/jwt": "^10.2.0",
		"@nestjs/passport": "^10.0.3",
		"@nestjs/platform-express": "^10.0.0",
		"@nestjs/platform-socket.io": "^10.4.22",
		"@nestjs/serve-static": "^4.0.2",
		"@nestjs/swagger": "^7.4.0",
		"@nestjs/throttler": "^6.2.1",
		"@nestjs/websockets": "^10.4.22",
		"@prisma/client": "^5.22.0",
		"argon2": "^0.40.1",
		"axios": "^1.12.2",
		"cache-manager": "^5.5.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cookie-parser": "^1.4.6",
		"dotenv": "^16.4.5",
		"helmet": "^7.1.0",
		"lodash": "^4.17.21",
		"nodemailer": "^6.9.13",
		"openai": "^4.65.0",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"qrcode": "^1.5.4",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.8.1",
		"socket.io": "^4.8.3",
		"speakeasy": "^2.0.0",
		"uuid": "^9.0.1"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.4.9",
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"@types/cookie-parser": "^1.4.7",
		"@types/express": "^4.17.17",
		"@types/jest": "^29.5.2",
		"@types/lodash": "^4.17.0",
		"@types/multer": "^1.4.11",
		"@types/node": "^20.19.24",
		"@types/nodemailer": "^6.4.14",
		"@types/passport-jwt": "^4.0.1",
		"@types/qrcode": "^1.5.6",
		"@types/speakeasy": "^2.0.10",
		"@types/uuid": "^9.0.8",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"eslint": "^8.42.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"jest": "^29.5.0",
		"prettier": "^3.0.0",
		"prisma": "^5.22.0",
		"source-map-support": "^0.5.21",
		"ts-jest": "^29.1.0",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.1.3"
	}
}
