model ClientRequest {
    id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    createdAt       DateTime             @default(now()) @map("created_at")
    updatedAt       DateTime             @updatedAt @map("updated_at")
    deletedAt       DateTime?            @map("deleted_at")
    deleted         Boolean              @default(false)
    fullName        String               @map("full_name") @db.VarChar(200)
    email           String               @db.VarChar(200)
    company         String?              @db.VarChar(200)
    phone           String?              @db.VarChar(50)
    projectType     String               @map("project_type") @db.VarChar(100)
    budget          String?              @db.VarChar(100)
    timeline        String?              @db.VarChar(100)
    description     String
    referenceLinks  String?              @map("reference_links")
    status          ClientRequestStatus  @default(PENDING)
    clientUserId    String?              @map("client_user_id") @db.Uuid
    clientUser      User?                @relation("ClientRequests", fields: [clientUserId], references: [id], onDelete: SetNull)
    replies         ClientRequestReply[]
    messages        ClientRequestMessage[]

    @@map("client_request")
}

enum ClientRequestStatus {
    PENDING
    REVIEWING
    REPLIED
    ACCEPTED
    DECLINED
    ARCHIVED
}

model ClientRequestReply {
    id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    createdAt    DateTime      @default(now()) @map("created_at")
    updatedAt    DateTime      @updatedAt @map("updated_at")
    deletedAt    DateTime?     @map("deleted_at")
    deleted      Boolean       @default(false)
    message      String
    request      ClientRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    requestId    String        @map("request_id") @db.Uuid
    repliedBy    User          @relation("AdminReplies", fields: [repliedById], references: [id], onDelete: Restrict)
    repliedById  String        @map("replied_by_id") @db.Uuid

    @@map("client_request_reply")
}

model ClientRequestMessage {
    id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    createdAt DateTime      @default(now()) @map("created_at")
    updatedAt DateTime      @updatedAt @map("updated_at")
    deletedAt DateTime?     @map("deleted_at")
    deleted   Boolean       @default(false)
    message   String
    request   ClientRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    requestId String        @map("request_id") @db.Uuid
    sender    User          @relation("ClientRequestMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
    senderId  String        @map("sender_id") @db.Uuid

    @@index([requestId, createdAt])
    @@map("client_request_message")
}
