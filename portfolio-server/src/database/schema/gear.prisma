model Gear {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  deleted        Boolean   @default(false)
  name           String    @db.VarChar(160)
  brand          String    @default("") @db.VarChar(120)
  category       String    @db.VarChar(100)
  description    String
  specifications String    @default("") @db.VarChar(1000)
  imageUrl       String    @default("") @map("image_url")
  altText        String    @map("alt_text") @db.VarChar(500)
  productUrl     String    @default("") @map("product_url")
  featured       Boolean   @default(false)
  published      Boolean   @default(false)
  sortOrder      Int       @default(0) @map("sort_order")

  @@index([deleted, published, sortOrder], map: "gear_public_list_idx")
  @@map("gear")
}
