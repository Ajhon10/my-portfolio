model Project {
    id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    createdAt     DateTime  @default(now()) @map("created_at")
    updatedAt     DateTime  @updatedAt @map("updated_at")
    deletedAt     DateTime? @map("deleted_at")
    deleted       Boolean   @default(false)
    title         String    @db.VarChar(200)
    slug          String    @unique @db.VarChar(220)
    description   String
    shortSummary  String?   @map("short_summary") @db.VarChar(300)
    thumbnailUrl  String?   @map("thumbnail_url")
    liveUrl       String?   @map("live_url") @db.VarChar(500)
    repoUrl       String?   @map("repo_url") @db.VarChar(500)
    category      String?   @db.VarChar(100)
    featured      Boolean   @default(false)
    published     Boolean   @default(true)
    sortOrder     Int       @default(0) @map("sort_order")
    techStack     ProjectTech[]
    images        ProjectImage[]

    @@map("project")
}

model ProjectTech {
    id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    projectId String   @map("project_id") @db.Uuid
    techId    String   @map("tech_id") @db.Uuid
    project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    tech      TechStack @relation(fields: [techId], references: [id], onDelete: Cascade)

    @@unique([projectId, techId])
    @@map("project_tech")
}

model ProjectImage {
    id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    createdAt DateTime @default(now()) @map("created_at")
    projectId String   @map("project_id") @db.Uuid
    url       String
    sortOrder Int      @default(0) @map("sort_order")
    project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@map("project_image")
}
