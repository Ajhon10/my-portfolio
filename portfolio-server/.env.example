NODE_ENV=development
APP_PORT=3000
APP_DOMAIN=http://localhost:5173
APP_TOKEN=replace-me-with-a-strong-secret

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio
# Optional direct connection for npm run db:migrate; DATABASE_URL may be pooled.
DIRECT_URL=

# Local development: local. Vercel: blob (selected automatically when VERCEL=1).
UPLOAD_STORAGE=local
BLOB_READ_WRITE_TOKEN=
# Use a Redis wire-protocol URL supporting Pub/Sub, not a REST endpoint.
REDIS_URL=
# Set a separate prefix for each production/preview environment.
REDIS_KEY_PREFIX=portfolio-local

# Required only when explicitly seeding a new production database. Never use
# the development owner credentials for a public deployment.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

ACCESS_TOKEN_SECRET=replace-with-strong-jwt-secret
ACCESS_TOKEN_EXPIRES_IN=1d

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=itsajhon@gmail.com
MAIL_PASS=app-password-here
MAIL_FROM=itsajhon@gmail.com

# Backend only. Create a project key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Cost-efficient default for the portfolio chatbot; use gpt-5.6-terra for higher quality.
OPENAI_MODEL=gpt-5.6-luna
