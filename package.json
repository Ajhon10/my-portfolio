{
	"name": "jhon-portfolio",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.14"
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "npm test && npm run typecheck && vite build",
		"typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
		"preview": "wrangler dev --port 8787",
		"test": "node --test tests/*.test.cjs && node scripts/test-worker.mjs",
		"db:migrate": "wrangler d1 migrations apply portfolio --local",
		"db:migrate:remote": "wrangler d1 migrations apply portfolio --remote",
		"db:migrate:preview": "wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc",
		"db:seed": "node scripts/seed.mjs",
		"owner:create": "node scripts/create-owner.mjs",
		"deploy": "npm run build && wrangler deploy",
		"deploy:check": "wrangler deploy --dry-run --outdir .deploy-check",
		"legacy:export": "node scripts/migration/export-postgres.mjs",
		"legacy:import": "node scripts/migration/import-legacy.mjs",
		"setup": "node scripts/setup-local.mjs",
		"test:browser": "node scripts/test-browser.mjs"
	},
	"dependencies": {
		"@noble/hashes": "2.4.0",
		"@vueuse/core": "^10.9.0",
		"axios": "^1.13.2",
		"gsap": "^3.12.5",
		"hono": "4.13.16",
		"nanoid": "^5.0.8",
		"pinia": "^2.1.7",
		"pinia-plugin-persistedstate": "3.2.1",
		"qrcode-generator": "2.0.4",
		"vue": "^3.5.22",
		"vue-router": "^4.3.0",
		"vue3-toastify": "^0.2.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.67.0",
		"@cloudflare/workers-types": "5.20261104.1",
		"@tsconfig/node22": "^22.0.0",
		"@types/node": "^22.19.0",
		"@types/pg": "^8.15.5",
		"@vitejs/plugin-vue": "^6.0.2",
		"@vue/tsconfig": "^0.8.1",
		"autoprefixer": "^10.4.19",
		"esbuild": "^0.25.12",
		"miniflare": "^5.20261103.0-beta",
		"pg": "^8.16.3",
		"playwright": "^1.56.1",
		"postcss": "^8.4.38",
		"prettier": "^3.6.2",
		"tailwindcss": "^3.4.3",
		"typescript": "~5.9.3",
		"vite": "^7.3.6",
		"vue-tsc": "^3.1.4",
		"wrangler": "4.157.0"
	}
}
