# Generate a private local value with: node scripts/setup-local.mjs
AUTH_SECRET=replace-with-a-random-32-byte-secret
# Optional integrations; leave empty to use grounded chatbot fallback and queued mail.
OPENAI_API_KEY=
MAIL_API_TOKEN=
MAIL_FROM=
MAIL_TO=
# Select resend (default) or smtp. Runtime secrets; never prefix with VITE_.
MAIL_TRANSPORT=resend
# SMTP: 587 requires STARTTLS; 465 uses implicit TLS. Port 25/plaintext is unsupported.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
